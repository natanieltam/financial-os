# Financial OS — environment placeholders (NO real secrets in this file)
# Copy to .env and fill in values. .env is git-ignored.

# PostgreSQL connection (server-side only)
DATABASE_URL=

# Session signing secret (server-side only)
SESSION_SECRET=

# Kenari OpenAI-compatible API (server-side only, never expose to client).
# These are read at build time (nuxt loads .env) and can be overridden at
# runtime on a BUILT server with the NUXT_ prefix:
#   NUXT_KENARI_BASE_URL / NUXT_KENARI_API_KEY / NUXT_KENARI_MODEL
# With key/model left empty, AI endpoints return 503 AI_UNAVAILABLE and the
# rest of the application keeps working (no fabricated provider success).
KENARI_BASE_URL=https://kenari.id/v1
KENARI_API_KEY=
KENARI_MODEL=
