# Financial OS — environment placeholders (NO real secrets in this file)
# Copy to .env and fill in values. .env is git-ignored.

# PostgreSQL connection (server-side only)
DATABASE_URL=

# Session signing secret (server-side only)
SESSION_SECRET=

# Kenari OpenAI-compatible API (server-side only, never expose to client)
KENARI_BASE_URL=https://kenari.id/v1
KENARI_API_KEY=
KENARI_MODEL=
